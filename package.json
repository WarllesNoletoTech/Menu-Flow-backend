{
  "name": "@menu-flow/backend",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "create-super-admin": "npm run build && node dist/scripts/create-super-admin.js",
    "check:legacy-links": "npm run build && node dist/scripts/check-legacy-user-links.js",
    "migrate:legacy-links": "npm run build && node dist/scripts/migrate-legacy-restaurant-links.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "tsc --noEmit",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "migrate:business-hours": "npm run build && node dist/scripts/migrate-business-hours.js",
    "test": "npm run build && node --test test/*.test.js",
    "migrate:money-orders": "npm run build && node dist/scripts/migrate-order-money-addons.js",
    "check:order-links": "npm run build && node dist/scripts/migrate-order-links.js",
    "migrate:order-links": "npm run build && node dist/scripts/migrate-order-links.js --apply",
    "check:integration-contracts": "npm run build && node dist/scripts/migrate-integration-contracts.js",
    "migrate:integration-contracts": "npm run build && node dist/scripts/migrate-integration-contracts.js --apply"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/throttler": "^6.4.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "mongoose": "^8.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/websockets": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.1",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
